<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vm.lite">

    <application
        android:extractNativeLibs="true" android:label="VM Lite">

        <!-- 极简 Launcher：注册为 HOME，替代 AOSP Launcher3 -->
        <activity
            android:name=".MinimalLauncher"
            android:label="VM Desktop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 设置入口，由 MinimalLauncher 启动 -->
        <activity
            android:name=".SettingsActivity"
            android:label="设置" />

        <!--
          浏览器不再自研：改用系统自带浏览器 com.android.browser，
          由 MinimalLauncher 通过包名启动，故此处不再声明 BrowserActivity，
          本应用亦不再需要 INTERNET 权限。
        -->

    </application>
</manifest>
